      "description": "GET /api/orders/{id} returns any order to any logged-in user.",
      "proof_steps": [
        "Log in as test account A and create order 1001.",
        "Log in as test account B and request GET /api/orders/1001.",
        "Order 1001 (account A) is returned; name and address fields redacted in evidence."
      ],
      "root_cause": "The handler fetches the order by primary key and never compares order.owner_id with the session user.",
      "impact": "Any customer can read every other customer's name, address and order history.",
      "remediation": {
        "summary": "Scope the query by the caller's user ID.",
        "language": "ts",
        "patch": "const order = await db.order.findFirst({ where: { id, ownerId: session.userId } });\nif (!order) return res.status(404).end();",
        "regression_note": "Admin views need a separate, role-checked endpoint."
      },
      "retest": {
        "action": "Repeat step 2 with account B.",
        "expected": "404 Not Found"
      },
